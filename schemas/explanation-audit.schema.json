{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trustrec.local/schemas/explanation-audit.schema.json",
  "title": "TrustRec explanation faithfulness audit",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "snapshot_id",
    "dataset_hash",
    "cutoff_timestamp",
    "configuration",
    "configuration_hash",
    "model_hash",
    "status",
    "row_counts",
    "audits"
  ],
  "properties": {
    "schema_version": {"type": "integer", "minimum": 1},
    "run_id": {"type": "string", "minLength": 1},
    "snapshot_id": {"type": "string", "minLength": 1},
    "dataset_hash": {"type": "string", "minLength": 8},
    "cutoff_timestamp": {"type": "string", "format": "date-time"},
    "source_evidence_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_claims_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "configuration": {"type": "object"},
    "configuration_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "model_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "status": {"enum": ["complete", "failed"]},
    "row_counts": {
      "type": "object",
      "required": ["recommendations", "audits"],
      "properties": {
        "recommendations": {"type": "integer", "minimum": 0},
        "audits": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "audits": {
      "type": "array",
      "items": {"$ref": "#/$defs/audit"}
    }
  },
  "$defs": {
    "audit": {
      "type": "object",
      "required": [
        "recommendation_id",
        "user_id",
        "item_id",
        "snapshot_id",
        "claim",
        "aspect",
        "sentiment_direction",
        "evidence_review_id",
        "evidence_review_ids",
        "evidence_offsets",
        "support_status",
        "audit_result",
        "original_score",
        "recomputed_score",
        "score_delta",
        "random_recomputed_score",
        "random_score_delta",
        "original_contributions",
        "recomputed_contributions",
        "random_recomputed_contributions",
        "removed_review_ids",
        "random_removed_review_ids",
        "seed",
        "candidate_set_hash",
        "normalization_fixed"
      ],
      "properties": {
        "recommendation_id": {"type": "string", "minLength": 1},
        "user_id": {"type": "string", "minLength": 1},
        "item_id": {"type": "string", "minLength": 1},
        "snapshot_id": {"type": "string", "minLength": 1},
        "claim": {"type": ["string", "null"]},
        "aspect": {"type": ["string", "null"]},
        "sentiment_direction": {
          "enum": ["positive", "negative", "neutral", "conflicting", null]
        },
        "evidence_review_id": {"type": ["string", "null"]},
        "evidence_review_ids": {"type": "array", "items": {"type": "string"}},
        "evidence_offsets": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["start", "end"],
            "properties": {
              "start": {"type": "integer", "minimum": 0},
              "end": {"type": "integer", "minimum": 1}
            },
            "additionalProperties": false
          }
        },
        "support_status": {
          "enum": ["supported", "insufficient_support", "unavailable"]
        },
        "audit_result": {
          "enum": ["faithful", "not_faithful", "abstained", "unavailable"]
        },
        "original_score": {"type": "number"},
        "recomputed_score": {"type": "number"},
        "score_delta": {"type": "number"},
        "random_recomputed_score": {"type": ["number", "null"]},
        "random_score_delta": {"type": ["number", "null"]},
        "original_contributions": {"type": "object", "additionalProperties": {"type": "number"}},
        "recomputed_contributions": {"type": "object", "additionalProperties": {"type": "number"}},
        "random_recomputed_contributions": {"type": "object", "additionalProperties": {"type": "number"}},
        "removed_review_ids": {"type": "array", "items": {"type": "string"}},
        "random_removed_review_ids": {"type": "array", "items": {"type": "string"}},
        "seed": {"type": "integer"},
        "candidate_set_hash": {"type": ["string", "null"]},
        "normalization_fixed": {"const": true},
        "refusal_reason": {"type": ["string", "null"]}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
